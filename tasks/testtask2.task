#!/bin/bash

function testtask2_define() {
    runRelativeToCallerProject=true
    requireTask genbuildinfo
    afterTask genbuildinfo

    requireTask testtask
    beforeTask testtask
}

function testtask2_run() {
    # Parse parameters
    if [ "${PARAMETERS["test"]}" != "" ]; then
        PROPERTIES+=(["TESTPROP"]="${PARAMETERS["test"]}")
    fi 
    echo ${PROPERTIES["TESTPROP"]}
}